#!/usr/bin/env bash
# wb — control stick for the Windows browser agent.
#
#   ./wb up              start Chrome + engine (leaves them alone if already up)
#   ./wb status          are they alive (the judge is CDP/engine responses, not the process list)
#   ./wb go <url>        open a page
#   ./wb read            summarize the current screen (title, links, buttons, inputs)
#   ./wb click <selector>
#   ./wb type <selector> <text>
#   ./wb press <key>     Enter, Tab, Escape ...
#   ./wb shot [path]     screenshot (default /tmp/win-shot.png)
#   ./wb tabs            numbered tab list — who is driving each one
#   ./wb take <#>        hand a tab you are on to the agent, so it carries on from there
#   ./wb release         give that tab back
#   ./wb down            take down the engine only (Chrome belongs to the user, so we don't touch it)
#
# 🔴 This script never kills Chrome. It may be a window the user was using.

set -uo pipefail
# 🔴 Resolve symlinks before taking the directory. Putting `wb` on your PATH means
#    symlinking it (ln -s .../Wbrowser/wb ~/.local/bin/wb), and a plain `dirname` would
#    then point at ~/.local/bin — where engine.js, launch.js and the Python helpers are
#    not. The script would run and fail to find its own project.
_SELF="${BASH_SOURCE[0]}"
while [ -L "$_SELF" ]; do
  _LINK="$(readlink "$_SELF")"
  case "$_LINK" in
    /*) _SELF="$_LINK" ;;
    *)  _SELF="$(dirname "$_SELF")/$_LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$_SELF")" && pwd)"
ENGINE="http://127.0.0.1:${WBROWSER_PORT:-7981}"
CDP="http://127.0.0.1:${WBROWSER_CDP_PORT:-9222}"
# 🔴 Logs record visited URLs — keep them out of the repo folder so zipping or
#    sharing the directory can't leak them. (.gitignore only guards git.)
_state_dir() {
  if [ -n "${WBROWSER_STATE_DIR:-}" ]; then echo "$WBROWSER_STATE_DIR"; return; fi
  case "$(uname -s)" in
    Darwin) echo "$HOME/Library/Application Support/wbrowser" ;;
    MINGW*|MSYS*|CYGWIN*) echo "${LOCALAPPDATA:-$HOME}/wbrowser" ;;
    *) echo "${XDG_STATE_HOME:-$HOME/.local/state}/wbrowser" ;;
  esac
}
mkdir -p "$(_state_dir)" 2>/dev/null
LOG="$(_state_dir)/engine.log"

# 🔴 A fresh clone has no node_modules, and every command here talks to an engine
#    over HTTP — so if someone else's engine happens to be on the port, a clone that
#    installed nothing answers "✅ Engine" and drives THEIR browser. Measured
#    2026-08-31 on a clean clone: `wb status` said everything was fine and `wb go`
#    opened a page in another user's Chrome. Nothing said npm install was missing,
#    because only `wb up` ever checks.
#    So check here, once, before anything is sent anywhere.
#    🔴 The test and the wording live in preflight.js, not here. They were in three
#       places with three different tests (a directory check here, require.resolve in
#       each entry point), and three tests for one fact can disagree — which is the
#       same shape as the bug this guard exists for.
_needs_install() {
  node "$DIR/preflight.js" 2>/dev/null && return 1
  # 🔵 --explain prints the same words the JS entry points print. Keeping the wording
  #    in one file is the point; duplicating it here would re-create the split.
  node "$DIR/preflight.js" --explain 2>&1 >/dev/null
  return 0
}

_post() {   # _post '<json>'
  curl -s --max-time "${WIN_TIMEOUT:-45}" -X POST "$ENGINE/act" \
    -H 'Content-Type: application/json' -d "$1"
}
_pretty() { python3 "$DIR/fmt.py"; }

# Don't assemble JSON in the shell — it silently breaks once quotes/backslashes get mixed in.
# Pass the arguments through as-is and let Python do the escaping.
# 🔵 Don't hardcode the agent name — it differs per machine.
#    AOE_INSTANCE_ID from the harness is the source of truth; without it, derive from the working directory.
_agent_name() {
  if [ -n "${WIN_AGENT:-}" ]; then echo "$WIN_AGENT"; return; fi
  # 🔴 AOE_INSTANCE_ID is a hash, not a human-readable name (measured: 1368cc4da26a4bdc).
  #    Putting it in a tab title leaves the user unable to tell whose tab it is — so we don't use it.
  #    Derive it from the working directory instead: .../<agents-dir>/<name>
  case "$PWD" in
    */AGENT/*|*/agents/*) echo "$PWD" | sed -E 's#.*/(AGENT|agents)/([^/]+).*#\2#'; return ;;
  esac
  # If the caller invoked us from somewhere else, look at the parent shell's working directory
  PARENT_CWD="$(readlink -f "/proc/$PPID/cwd" 2>/dev/null)"
  case "$PARENT_CWD" in
    */AGENT/*|*/agents/*) echo "$PARENT_CWD" | sed -E 's#.*/(AGENT|agents)/([^/]+).*#\2#'; return ;;
  esac
  # 🔴 Last resort: name it after the host user, never empty.
  #    An empty name used to be returned here on the reasoning that a bogus name is worse
  #    than none. It is not: the label is the whole point of driving a window the human can
  #    see, and an empty name turns it off **silently**. Measured 2026-08-25: running from
  #    the repo root instead of AGENT/<name> produced a plain `Google` title with no banner,
  #    no warning, and the automation working fine — so nothing tells you the one safety
  #    feature is off. Running from the repo root is what a fresh clone does by default.
  #    A generic name still says "an agent is driving this", which is the claim that matters.
  echo "agent@$(id -un 2>/dev/null || echo unknown)"
}
AGENT_NAME="$(_agent_name)"

_json() {
  WIN_ACCOUNT_RESOLVED="$ACCOUNT" WIN_AGENT="$AGENT_NAME" \
    python3 "$DIR/mkcmd.py" "$@"
}

_cdp_up()    { curl -s --max-time 2 "$CDP/json/version"  2>/dev/null | grep -q Browser; }
_engine_up() { curl -s --max-time 2 "$ENGINE/health"     2>/dev/null | grep -q '"ok"'; }

# Accept --account <hint> at any position. Without an account, the default window.
ACCOUNT="${WIN_ACCOUNT:-}"
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --account|-a) ACCOUNT="${2:-}"; shift 2 || shift ;;
    --account=*)  ACCOUNT="${1#--account=}"; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

cmd="${1:-status}"; shift || true

# 🔴 One gate, before the dispatch. Gating command by command means the next command
#    added is unguarded by default — `shot` and `tabs` were, and on a fresh clone they
#    reached a stranger's engine and captured their screen. Only `up` and `version` run
#    without dependencies: one installs nothing but explains, the other just reads a file.
case "$cmd" in
  up|version|--version|-v|help|--help|-h) ;;
  *) _needs_install && exit 1 ;;
esac

case "$cmd" in
  up)
    if _cdp_up; then echo "· Chrome already up"; else
      # 🔴 The default is "attach to the Chrome the user is logged into", not launching a new one.
      #    Chrome locks the default profile so we can't launch it, and if we do launch one
      #    it becomes an empty window with no logins, which is useless.
      #    If you need an empty dedicated window, state it explicitly with WIN_OWN_PROFILE=1.
      # If there is a copied logged-in profile, launch straight with that.
      if true; then
        # If you passed an account via --account, start with that profile
        if [ -n "$ACCOUNT" ]; then
          P="$(python3 "$DIR/findprofile.py" "$ACCOUNT" 2>/dev/null)"
          [ -n "$P" ] && export CHROME_PROFILE_DIR="$P" \
            && echo "· Starting profile: $P ($ACCOUNT)"
        fi
        node "$DIR/launch.js" || exit 1
      else
        echo "❌ No logged-in Chrome is running."
        echo "     (If Chrome is already running, close them all first, then run it — check the tray icon too)"
        echo
        echo "   🔵 If you want an empty dedicated window with no logins: WIN_OWN_PROFILE=1 ./wb up"
        exit 1
      fi
    fi
    if _engine_up; then echo "· Engine already up"; else
      nohup node "$DIR/engine.js" > "$LOG" 2>&1 &
      for _ in $(seq 1 25); do _engine_up && break; sleep 0.4; done
      if _engine_up; then echo "· Engine started $ENGINE"
      else echo "❌ Engine won't come up. Log: $LOG"; tail -5 "$LOG"; exit 1; fi
    fi
    echo "✅ Ready"
    ;;
  version|--version|-v)
    # Local version comes from package.json — the one file that is always present.
    LOCAL=$(python3 -c "import json;print(json.load(open('$DIR/package.json'))['version'])" 2>/dev/null || echo "unknown")
    echo "wbrowser $LOCAL"

    # 🔵 The check is opt-out, not opt-in, but it never blocks and never fails the
    #    command: no network, rate-limited, or offline all just print nothing extra.
    #    WBROWSER_NO_UPDATE_CHECK=1 skips it entirely.
    [ -n "${WBROWSER_NO_UPDATE_CHECK:-}" ] && exit 0

    LATEST=$(curl -fsS --max-time 4 \
      https://api.github.com/repos/w-partners/Wbrowser/releases/latest 2>/dev/null \
      | python3 -c "import json,sys;print(json.load(sys.stdin).get('tag_name',''))" 2>/dev/null || true)

    # 🔴 An empty answer means "could not ask", NOT "you are up to date".
    #    Saying "up to date" on a failed lookup is the silent failure this project
    #    keeps guarding against — so say which one actually happened.
    if [ -z "$LATEST" ]; then
      echo "· Could not reach GitHub to check for updates (offline or rate-limited)."
      echo "  Check by hand: https://github.com/w-partners/Wbrowser/releases"
      exit 0
    fi

    if [ "v$LOCAL" = "$LATEST" ]; then
      echo "· Up to date (latest release is $LATEST)"
    else
      echo ""
      echo "🔵 A newer release is available: $LATEST (you have v$LOCAL)"
      echo "   What changed:  https://github.com/w-partners/Wbrowser/blob/main/CHANGELOG.md"
      echo "   Update:        git pull && npm install"
      echo "   Forked it?     git pull https://github.com/w-partners/Wbrowser main"
    fi
    ;;
  status)
    # 🔴 Say this first, because everything below it would otherwise be a lie: without
    #    dependencies nothing here can run, and an engine answering on the port is
    #    someone else's — a clean clone printed "✅ Engine" and meant another person's
    #    browser (measured 2026-08-31).
    # 🔵 Don't judge with tasklist/netstat — under mirrored WSL all three fail to see
    #    Chrome while CDP responds fine (measured 2026-08-23).
    _cdp_up    && echo "✅ Chrome (CDP $CDP)" || echo "❌ Chrome — ./wb up"
    # 🔴 Say which build is answering, not just that something is. Reported 2026-08-31:
    #    a fix was released and pulled, and an engine started before the pull kept the
    #    port, so old code answered every request. Working that out took comparing
    #    process start times by hand — this line answers it instead.
    if _engine_up; then
      curl -s --max-time 5 "$ENGINE/health" 2>/dev/null | python3 -c "
import json, sys
try: d = json.load(sys.stdin)
except Exception: d = {}
b, t = d.get('build'), (d.get('startedAt') or '')[:19].replace('T', ' ')
extra = ('  ' + b if b else '') + ('  up since ' + t + ' UTC' if t else '')
print('✅ Engine (' + '$ENGINE' + ')' + extra)
"
    else echo "❌ Engine — ./wb up"; fi
    # 🔴 Show what the engine says is wrong, not just that something is.
    #    /health returns a hint naming the actual cause; status used to grep for "ok"
    #    and throw the rest away. Measured 2026-08-25: someone read this output dozens
    #    of times while the engine was reporting "Chrome is answering but cannot be
    #    attached to" — and went looking outside the tool, because status never said it.
    if _engine_up; then :; else
      # 🔴 Give this longer than the liveness probe above. Working out *why* we cannot
      #    attach means letting connect() reach its own 10s timeout first — a 3s budget
      #    here cuts the answer off and prints nothing, which is the silence we are fixing.
      echo "   (checking why...)" >&2
      curl -s --max-time 20 "$ENGINE/health" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not d.get('browser'):
    if d.get('hint'):   print('   ' + d['hint'])
    if d.get('detail'): print('   detail: ' + d['detail'][:150])
" 2>/dev/null
    fi
    # 🔴 Don't stop at "attached" — whether it's a logged-in window or an empty one is the real issue.
    _cdp_up && WBROWSER_ENGINE="$ENGINE" python3 "$DIR/whoami.py" "$CDP"
    ;;
  whoami)
    _cdp_up || { echo "❌ Chrome is not running"; exit 1; }
    WBROWSER_ENGINE="$ENGINE" python3 "$DIR/whoami.py" "$CDP" --verbose
    ;;
  go|read|click|type|press|console|errors|network|eval)
          _post "$(_json "$cmd" "$@")" | _pretty ;;
  tabs)
    # 🔴 The engine is the single source of the numbering. This used to read Chrome's
    #    /json directly and number the tabs itself, while the engine numbered them again
    #    from its own page list — so `./wb take 3` could mean a different tab than the 3
    #    you just read here. One counter, one place.
    _engine_up || { echo "❌ Engine is not running — ./wb up"; exit 1; }
    curl -s --max-time 30 "$ENGINE/tabs" | python3 -c "
import json, sys
d = json.load(sys.stdin)
tabs = d.get('open') or []
if not tabs:
    print('No open tabs.'); sys.exit(0)
# 🔴 Never truncate the owner. This column exists to answer 'whose tab is this',
#    and a cut name answers it wrongly rather than not at all — measured 2026-08-25:
#    'wbrowser-primary::main' printed as 'wbrowser-prim' and an agent named '' printed
#    as '::main', which reads as though nobody owns it. Size the column to the data.
rows = [((t.get('drivenBy') or '— (yours)'), (t.get('title') or '(untitled)'), t) for t in tabs]
w = max(len(r[0]) for r in rows)
print(f\"  #  {'driven by':<{w}}  {'title':<38}  url\")
for who, title, t in rows:
    print(f\"  {t['n']:<2} {who:<{w}}  {title[:38]:<38}  {(t.get('url') or '')[:40]}\")
print()
print('  ./wb take <#>   hand that tab to the agent')
print('  ./wb release    give it back')
"
    ;;
  take)
    # Hand the tab you are looking at to the agent, by its number from ./wb tabs.
    # 🔴 Check it is a number here, not just in the engine. An unquoted value goes straight
    #    into the JSON body and breaks the request with a parse error that says nothing about
    #    what the user actually typed.
    case "${1:-}" in
      ''|*[!0-9]*) echo "Usage: ./wb take <#> [tab-name]   — <#> is a number from ./wb tabs"; exit 1 ;;
    esac
    _engine_up || { echo "❌ Engine is not running — ./wb up"; exit 1; }
    # 🔴 Refuse rather than take a tab under an empty name. An unnamed hold cannot be told
    #    apart from anyone else's, and ./wb release would not know what to give back.
    [ -n "$AGENT_NAME" ] || {
      echo "❌ Cannot tell which agent this is, so the tab would be held under no name."
      echo "   Run from an agent directory (.../AGENT/<name>) or set WIN_AGENT=<name>."
      exit 1
    }
    curl -s --max-time 30 -X POST "$ENGINE/take" -H 'Content-Type: application/json' \
      -d "{\"n\": $1, \"agent\": \"$AGENT_NAME\", \"tab\": \"${2:-main}\"}" \
      | python3 -c "
import json, sys
d = json.load(sys.stdin)
if d.get('error'):
    print('❌', d['error']); sys.exit(1)
t = d['taken']
print(f\"✅ Took tab {t['n']}: {t.get('title') or ''}\")
print(f\"   {t.get('url') or ''}\")
print(f\"   The agent carries on from here. ./wb release gives it back.\")
"
    ;;
  release)
    _engine_up || { echo "❌ Engine is not running — ./wb up"; exit 1; }
    curl -s --max-time 30 -X POST "$ENGINE/release" -H 'Content-Type: application/json' \
      -d "{\"agent\": \"$AGENT_NAME\", \"tab\": \"${1:-main}\"}" \
      | python3 -c "
import json, sys
d = json.load(sys.stdin)
if d.get('error'):
    print('❌', d['error']); sys.exit(1)
print(f\"✅ Released — the tab is yours again: {d.get('url') or ''}\")
"
    ;;
  logins)
    # What are we logged into (by cookie domain). We never look at the values.
    _cdp_up || { echo "❌ Browser is not running — ./wb up"; exit 1; }
    curl -s --max-time 30 "$ENGINE/logins" | python3 -c "
import json,sys
d=json.load(sys.stdin)
if 'error' in d: print('❌', d['error']); sys.exit(1)
for c in d.get('contexts', []):
    doms = c.get('domains') or []
    print('Profile: %s' % (c.get('profile') or '(unknown)'))
    print('  %d cookies / %d domains' % (c.get('totalCookies',0), len(doms)))
    if not doms:
        print('  🔵 Not logged into any site yet')
    for x in doms[:25]:
        print('    %4d  %s' % (x['count'], x['domain']))
    if len(doms) > 25:
        print('    ... and %d more' % (len(doms)-25))
"
    ;;
  windows)
    # Show the profile windows the user opened, grouped by account.
    curl -s --max-time 30 "$ENGINE/windows" | python3 "$DIR/fmtwin.py"
    ;;
  show)
    # 🔵 The answer to "there are too many Chrome windows, I can't tell which one is the agent's".
    #    Bring that window to the front over CDP — effectively pointing at it on screen.
    if ! _cdp_up; then echo "❌ The agent browser is not running — ./wb up"; exit 1; fi
    # 🔴 Through _json, so this touches *this* agent's tab. A bare {"read":true} carries
    #    no agent name and lands on whichever tab the unnamed agent owns — so "show me
    #    the agent's window" would raise the wrong one. Same defect as shot had.
    _post "$(_json read)" >/dev/null 2>&1
    python3 - "$CDP" <<'PY'
import json, sys, urllib.request
cdp = sys.argv[1]
try:
    tabs = json.load(urllib.request.urlopen(cdp + "/json", timeout=5))
except Exception as e:
    print("❌ CDP query failed:", e); sys.exit(1)
pages = [t for t in tabs if t.get("type") == "page"]
if not pages:
    print("❌ No tabs"); sys.exit(1)
# Bring to front with Page.bringToFront. Use the activate endpoint, which works without WebSocket.
try:
    urllib.request.urlopen(cdp + "/json/activate/" + pages[0]["id"], timeout=5).read()
    print("✅ Brought the agent browser window to the front.")
except Exception as e:
    print("🔵 Window activation failed (please find it manually):", e)
print("   Look for '🤖 Wbrowser' in the title bar / taskbar.")
print("   Currently open tabs:")
for t in pages:
    print("    -", (t.get("title") or "(untitled)")[:60])
PY
    ;;
  close)
    # Close only the tabs my agent opened. 🔴 Closing the last tab shuts the browser
    #    down with it (measured 2026-08-23) — always leave one behind.
    python3 - "$CDP" "$AGENT_NAME" <<'PY'
import json, re, sys, urllib.request
cdp, me = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "")
try:
    tabs = [t for t in json.load(urllib.request.urlopen(cdp + "/json", timeout=5))
            if t.get("type") == "page"]
except Exception:
    print("❌ Browser is not running"); sys.exit(1)

mine = [t for t in tabs if me and (t.get("title") or "").startswith(f"[{me}]")]
if not mine:
    print(f"· '{me}' has no open tabs"); sys.exit(0)
# If every tab is mine, leave one behind — otherwise the browser dies.
keep = 1 if len(mine) == len(tabs) else 0
closed = 0
for t in mine[keep:]:
    try:
        urllib.request.urlopen(cdp + "/json/close/" + t["id"], timeout=3).read(); closed += 1
    except Exception:
        pass
print(f"· Closed {closed} tabs" + ("  (kept 1 to keep the browser alive)" if keep else ""))
PY
    ;;
  home)
    # Go back to the guide screen (when you want to see the login instructions again).
    # 🔵 The path must match what launch.js computed — so we ask it there.
    URL="$(node -e '
      const m = require("path");
      process.argv[1];
      const p = process.env.CHROME_PROFILE_WIN;
      if (p) { console.log("file:///" + p.replace(/\\\\/g,"/") + "/home.html"); }
    ' 2>/dev/null)"
    if [ -z "$URL" ]; then
      # Instead of asking the running browser where its profile is, use the standard location
      URL="$(ls -d /mnt/c/Users/*/.wbrowser 2>/dev/null | head -1 \
             | sed 's#^/mnt/\(.\)/#file:///\U\1\E:/#')/home.html"
    fi
    [ -n "$URL" ] && _post "$(_json go "$URL")" >/dev/null && echo "· Moved to the guide screen: $URL" \
      || echo "❌ Could not find the guide screen path"
    ;;
  shot)
    OUT="${1:-/tmp/win-shot.png}"
    # 🔴 Must go through _json so the agent name is attached. Sending a bare
    #    {"shot":true} leaves the agent empty, and the engine then resolves that to a
    #    *different* tab — the one belonging to the unnamed agent — so the screenshot
    #    is of a blank page while every other command in the session works fine.
    #    Measured 2026-08-25: 4,742 bytes of white against 253,713 for the real page.
    #    Nothing reports an error; the file is written and looks plausible until opened.
    _post "$(_json shot)" | python3 -c "
import json,sys,base64
d=json.load(sys.stdin)
if 'error' in d: print('❌', d['error']); sys.exit(1)
b=d.get('screenshot_b64')
if not b: print('❌ Screenshot is empty'); sys.exit(1)
open('$OUT','wb').write(base64.b64decode(b))
print('Saved:', '$OUT')
"
    ;;
  logs)
    # 🔵 Logs live outside the repo (they record visited URLs), so give the user
    #    an easy way to reach them — convenience shouldn't cost repo hygiene.
    if [ ! -f "$LOG" ]; then
      echo "No log yet: $LOG"
    else
      echo "· $LOG"
      tail -n "${1:-40}" "$LOG"
    fi
    ;;
  down)
    # 🔴 pkill -f also catches ourselves and the parent shell (if the same string is on their command line).
    #    It actually killed the shell that invoked this script (2026-08-23). Narrow the target.
    KILLED=0
    for pid in $(pgrep -f 'node .*engine\.js' 2>/dev/null); do
      [ "$pid" = "$$" ] && continue
      [ "$pid" = "$PPID" ] && continue
      # node processes only (not shells)
      case "$(readlink -f /proc/$pid/exe 2>/dev/null)" in *node*) kill "$pid" 2>/dev/null && KILLED=1;; esac
    done
    [ "$KILLED" = 1 ] && echo "· Engine taken down" || echo "· Engine was not running"
    echo "🔵 Leaving Chrome alone (it may be a user window). To turn it off, close the window."
    ;;
  help|--help|-h)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}" ;;
  # 🔴 A typo used to print the help and exit 0 — so `wb reed` looked like it had run,
  #    and a script wrapping it could not tell the difference. Same shape as the engine
  #    accepting {"action":"read"} with a 200: a mistake that reports success sends you
  #    looking at the browser instead of at what you typed.
  *)
    printf '❌ No such command: %s\n\n' "$cmd" >&2
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}" >&2
    exit 1 ;;
esac
